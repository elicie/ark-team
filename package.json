{
  "name": "ark-team-repository",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && esbuild plugins/ark-team/runtime/src/server.ts --bundle --minify-whitespace --platform=node --format=esm --target=node18 --outfile=plugins/ark-team/runtime/dist/server.js && esbuild plugins/ark-team/runtime/src/session-cli.ts --bundle --minify-whitespace --platform=node --format=esm --target=node18 --outfile=plugins/ark-team/runtime/dist/session-cli.js && esbuild plugins/ark-team/runtime/src/approval-session.ts --bundle --minify-whitespace --platform=node --format=esm --target=node18 --outfile=plugins/ark-team/runtime/dist/approval-session.js && node plugins/ark-team/runtime/scripts/normalize-bundle.mjs",
    "test:unit": "tsx --test plugins/ark-team/runtime/test/state-store.test.ts plugins/ark-team/runtime/test/agent-contract.test.ts plugins/ark-team/runtime/test/role-contracts.test.ts plugins/ark-team/runtime/test/worktree-manager.test.ts plugins/ark-team/runtime/test/plan-materializer.test.ts plugins/ark-team/runtime/test/orchestrator.test.ts plugins/ark-team/runtime/test/team-coordinator.test.ts plugins/ark-team/runtime/test/retry-coordinator.test.ts plugins/ark-team/runtime/test/integration-coordinator.test.ts plugins/ark-team/runtime/test/managed-session.test.ts plugins/ark-team/runtime/test/approval-session.test.ts plugins/ark-team/runtime/test/assignment-scheduler.test.ts",
    "test:mcp": "tsx --test plugins/ark-team/runtime/test/mcp-smoke.test.ts plugins/ark-team/runtime/test/assignment-mcp.test.ts plugins/ark-team/runtime/test/orchestrator-mcp.test.ts",
    "test:cli": "tsx --test plugins/ark-team/runtime/test/session-cli.test.ts",
    "test": "npm run test:unit && npm run build && npm run test:cli && npm run test:mcp",
    "verify:codex-models": "node plugins/ark-team/runtime/scripts/verify-codex-models.mjs",
    "verify:app-server-schema": "node plugins/ark-team/runtime/scripts/verify-app-server-schema.mjs",
    "verify:approval-gateway": "tsx plugins/ark-team/runtime/scripts/probe-approval-gateway.ts",
    "verify:managed-sessions": "tsx plugins/ark-team/runtime/scripts/probe-managed-sessions.ts",
    "validate": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@openai/codex-sdk": "0.145.0",
    "zod": "4.4.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "esbuild": "0.28.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
