{
  "name": "ark-team-repository",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && esbuild plugins/ark-team/runtime/src/server.ts --bundle --minify-whitespace --platform=node --format=esm --target=node18 --external:./adapters/openai-chat.js --external:@playwright/test --outfile=plugins/ark-team/runtime/dist/server.js && esbuild plugins/ark-team/runtime/src/session-cli.ts --bundle --minify-whitespace --platform=node --format=esm --target=node18 --external:./adapters/openai-chat.js --external:@playwright/test --outfile=plugins/ark-team/runtime/dist/session-cli.js && esbuild plugins/ark-team/runtime/src/approval-session.ts --bundle --minify-whitespace --platform=node --format=esm --target=node18 --external:./adapters/openai-chat.js --external:@playwright/test --outfile=plugins/ark-team/runtime/dist/approval-session.js && esbuild plugins/ark-team/runtime/src/adapters/openai-chat.ts --bundle --minify-whitespace --platform=node --format=esm --target=node18 --outfile=plugins/ark-team/runtime/dist/adapters/openai-chat.js && node plugins/ark-team/runtime/scripts/normalize-bundle.mjs && npm run verify:provider-provenance",
    "test:unit": "node plugins/ark-team/runtime/scripts/verify-provider-provenance.mjs --source-only && tsx --test plugins/ark-team/runtime/test/state-store.test.ts plugins/ark-team/runtime/test/project-config.test.ts plugins/ark-team/runtime/test/provider-config.test.ts plugins/ark-team/runtime/test/verification-contract.test.ts plugins/ark-team/runtime/test/verification-artifact-store.test.ts plugins/ark-team/runtime/test/verification-coordinator.test.ts plugins/ark-team/runtime/test/verification-readiness.test.ts plugins/ark-team/runtime/test/verification-api-adapter.test.ts plugins/ark-team/runtime/test/verification-browser-adapter.test.ts plugins/ark-team/runtime/test/verification-visual-adapter.test.ts plugins/ark-team/runtime/test/verification-semantic-review-adapter.test.ts plugins/ark-team/runtime/test/verification-agentic-browser-adapter.test.ts plugins/ark-team/runtime/test/verification-execution.test.ts plugins/ark-team/runtime/test/verification-bootstrap.test.ts plugins/ark-team/runtime/test/agent-contract.test.ts plugins/ark-team/runtime/test/role-contracts.test.ts plugins/ark-team/runtime/test/worktree-manager.test.ts plugins/ark-team/runtime/test/plan-materializer.test.ts plugins/ark-team/runtime/test/orchestrator.test.ts plugins/ark-team/runtime/test/team-coordinator.test.ts plugins/ark-team/runtime/test/retry-coordinator.test.ts plugins/ark-team/runtime/test/integration-coordinator.test.ts plugins/ark-team/runtime/test/managed-session.test.ts plugins/ark-team/runtime/test/approval-session.test.ts plugins/ark-team/runtime/test/app-server-client.test.ts plugins/ark-team/runtime/test/openai-chat-adapter.test.ts plugins/ark-team/runtime/test/provider-bridge.test.ts plugins/ark-team/runtime/test/provider-runtime.test.ts plugins/ark-team/runtime/test/routine-approval.test.ts plugins/ark-team/runtime/test/assignment-scheduler.test.ts",
    "test:verification-runtime": "tsx --test --test-concurrency=1 plugins/ark-team/runtime/test/verification-local-runtime.test.ts plugins/ark-team/runtime/test/verification-playwright-runtime.test.ts",
    "test:mcp": "tsx --test plugins/ark-team/runtime/test/mcp-smoke.test.ts plugins/ark-team/runtime/test/assignment-mcp.test.ts plugins/ark-team/runtime/test/orchestrator-mcp.test.ts plugins/ark-team/runtime/test/provider-mcp.test.ts",
    "test:provider-e2e": "tsx --test plugins/ark-team/runtime/test/provider-app-server-e2e.test.ts",
    "test:cli": "tsx --test plugins/ark-team/runtime/test/session-cli.test.ts",
    "test": "npm run test:unit && npm run test:verification-runtime && npm run test:provider-e2e && npm run build && npm run test:cli && npm run test:mcp",
    "verify:codex-models": "node plugins/ark-team/runtime/scripts/verify-codex-models.mjs",
    "verify:app-server-schema": "node plugins/ark-team/runtime/scripts/verify-app-server-schema.mjs",
    "verify:provider-provenance": "node plugins/ark-team/runtime/scripts/verify-provider-provenance.mjs",
    "verify:approval-gateway": "tsx plugins/ark-team/runtime/scripts/probe-approval-gateway.ts",
    "verify:managed-sessions": "tsx plugins/ark-team/runtime/scripts/probe-managed-sessions.ts",
    "verify:installed-plugin": "node plugins/ark-team/runtime/scripts/verify-installed-plugin.mjs",
    "validate": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@playwright/test": "1.62.0",
    "smol-toml": "1.7.0",
    "zod": "4.4.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "esbuild": "0.28.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
